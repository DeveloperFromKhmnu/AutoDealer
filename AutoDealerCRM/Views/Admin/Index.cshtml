@model List<AutoDealerCRM.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "Керування користувачами";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>👥 Облікові записи персоналу</h2>
    <a asp-action="CreateManager" class="btn btn-warning fw-bold">+ Створити нового менеджера</a>
</div>

<div class="alert alert-secondary py-2 small">
    💡 <strong>Безпековий контекст (ЛР №4 та ЛР №5):</strong> Рольова модель RBAC. 
    Блокування користувача забороняє йому вхід у систему навіть при вірному паролі. Адміністратор не може заблокувати самого себе.
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover table-bordered align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Email / Логін</th>
                <th>Роль</th>
                <th>Дата реєстрації</th>
                <th>Статус</th>
                <th>Дія блокування</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr class="@(u.IsBlocked ? "table-danger" : "")">
                    <td class="fw-bold">@u.Email</td>
                    <td>
                        <span class="badge @(u.Role.Contains("Admin") ? "bg-danger" : "bg-info text-dark")">
                            @u.Role
                        </span>
                    </td>
                    <td>@u.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (u.IsBlocked)
                        {
                            <span class="badge bg-danger">Заблоковано</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Активний</span>
                        }
                    </td>
                    <td>
                        @if (u.Email == User.Identity?.Name)
                        {
                            <span class="text-muted small">Поточний користувач</span>
                        }
                        else
                        {
                            <form asp-action="ToggleBlockUser" asp-route-id="@u.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(u.IsBlocked ? "btn-outline-success" : "btn-outline-danger")">
                                    @(u.IsBlocked ? "Розблокувати" : "Заблокувати")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
