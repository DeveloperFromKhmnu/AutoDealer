@model AutoDealerCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Вхід у систему";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow border-0">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0">Авторизація персоналу</h4>
                <small class="text-secondary">ASP.NET Core Identity &amp; Cookie Auth</small>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-secondary small mb-3">
                    <strong>Демо-акаунти для перевірки:</strong><br />
                    • <strong>Адмін:</strong> <code>admin@dealercrm.local</code> / <code>Admin123!</code><br />
                    • <strong>Менеджер:</strong> <code>manager@dealercrm.local</code> / <code>Manager123!</code>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@dealercrm.local" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Увійти</button>
                </form>
            </div>
            <div class="card-footer text-muted small bg-light text-center">
                ЛР №4: Паролі захищені PBKDF2, сесія через HttpOnly-куки, захист від timing-атак.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
